#!/usr/bin/env bash
set -euo pipefail

is_private_ref() {
  local ref="$1"
  [[ "$ref" == refs/heads/private || "$ref" == refs/heads/private/* ]]
}

branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$branch" == private || "$branch" == private/* ]]; then
  echo "push blocked: branch '$branch' is private/*" >&2
  echo "switch to a release/public branch before push." >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if is_private_ref "${local_ref:-}" || is_private_ref "${remote_ref:-}"; then
    echo "push blocked: private branch ref detected in push input." >&2
    echo "local_ref='${local_ref:-}' remote_ref='${remote_ref:-}'" >&2
    echo "do not push refs/heads/private/* to remote." >&2
    exit 1
  fi
done
